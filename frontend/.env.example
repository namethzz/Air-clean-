# Backend API URL required for sign-in and saving real data.
VITE_API_BASE_URL=http://localhost:5080/api
# Optional: show "Sign in with Google / Apple". Use the same client IDs as the API's GOOGLE_CLIENT_ID / APPLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
# Optional: Apple Return URL registered for the Services ID (defaults to this site's home page).
VITE_APPLE_REDIRECT_URI=
# Optional: contact email shown on /privacy.html and /terms.html for data requests.
VITE_CONTACT_EMAIL=
