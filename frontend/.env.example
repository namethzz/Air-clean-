# Backend API URL required for sign-in and saving real data.
VITE_API_BASE_URL=http://localhost:5080/api
# Optional: show "Sign in with Google". Use the same client ID as the API's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
# Optional: contact email shown on /privacy.html and /terms.html for data requests.
VITE_CONTACT_EMAIL=
# Optional: Google Places search for addresses and buildings (the same places as Google Maps).
# Without it, search uses OpenStreetMap. Restrict the key to this site and to "Places API (New)".
VITE_GOOGLE_MAPS_API_KEY=
